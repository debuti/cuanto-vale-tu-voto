{
  "name": "cuanto-vale-tu-voto",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite dev",
    "data": "node scripts/update-data.mjs",
    "brand": "node scripts/render-brand.mjs",
    "build": "vite build && node scripts/post-build.mjs",
    "preview": "wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "gate": "npm run check && npm run test -- --reporter=dot && npm run build && npm run e2e",
    "deploy": "npm run gate && wrangler deploy && npm run smoke",
    "e2e": "playwright test",
    "smoke": "NODE_OPTIONS=--dns-result-order=ipv4first SMOKE_URL=https://labs.nubuza.com/cuanto-vale-tu-voto/ playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@playwright/test": "1.56.1",
    "@resvg/resvg-js": "2.6.2",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "jsdom": "29.1.1",
    "playwright-core": "1.56.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "valibot": "1.5.0",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wawoff2": "2.0.1",
    "wrangler": "4.162.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
